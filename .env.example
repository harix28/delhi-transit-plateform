# Copy to .env and fill locally. Never commit .env.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# GTFS-Realtime vehicle positions; key is sent only by the backend.
TRANSPORTSTACK_API_KEY=
TRANSPORTSTACK_VEHICLE_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb

# Optional separately approved ETA service credential
TRANSPORTSTACK_ETA_API_KEY=

# Verified rider profiles (Supabase publishable key, never service_role)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set to the exact public HTTPS origin when deploying.
# APP_ORIGIN=https://your-app.example

# Dataset selection is respected everywhere. Use config.demo.yaml only for a synthetic demo.
TRANSIT_CONFIG=config.yaml
